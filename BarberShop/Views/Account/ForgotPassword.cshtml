@{
    ViewData["Title"] = "Forgot Your Password?";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Password Reset Request</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Enter your email address and we'll send you a link to reset your password.</p>

                    <form method="post" asp-action="ForgotPassword">
                        <div class="mb-3">
                            <label for="Email" class="form-label">Email Address</label>
                            <input type="email" class="form-control" id="Email" name="email" required placeholder="Enter your email">
                            <small class="form-text text-muted">We'll send a password reset link to this email.</small>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Send Reset Link</button>
                    </form>

                    <hr>

                    <p class="text-center mb-0">
                        <a href="@Url.Action("Login", "Account")">Back to Login</a> | 
                        <a href="@Url.Action("Register", "Account")">Create Account</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
