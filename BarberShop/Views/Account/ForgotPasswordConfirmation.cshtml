@{
    ViewData["Title"] = "Password Reset Request Sent";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                <h4 class="alert-heading">Check Your Email</h4>
                <p>@ViewBag.Message</p>
                <hr>
                <p class="mb-0">
                    <small>If you don't see the email in your inbox, please check your spam folder.</small>
                </p>
            </div>

            <div class="text-center mt-4">
                <p>
                    <a href="@Url.Action("Login", "Account")" class="btn btn-primary">Back to Login</a>
                </p>
            </div>
        </div>
    </div>
</div>
