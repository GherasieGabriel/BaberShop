@model Barber
@{
    Layout = "_BarberLayout";
    ViewData["Title"] = "Edit Barber";
}

<div class="container-centered">
    <h1 class="mb-3">Edit Barber</h1>

    @if (TempData["BookingSuccess"] is not null)
    {
        <div class="alert alert-success">@TempData["BookingSuccess"]</div>
    }

    @if (TempData["BookingError"] is not null)
    {
        <div class="alert alert-danger">@TempData["BookingError"]</div>
    }

    <form method="post" asp-action="Update" class="booking-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="originalEmail" value="@Model.Email" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <label>First Name <input asp-for="FirstName" type="text" /></label>
        <span asp-validation-for="FirstName" class="text-danger"></span>
        <label>Last Name <input asp-for="LastName" type="text" /></label>
        <span asp-validation-for="LastName" class="text-danger"></span>
        <label>Phone <input asp-for="Phone" type="text" /></label>
        <span asp-validation-for="Phone" class="text-danger"></span>
        <label>Email <input asp-for="Email" type="email" /></label>
        <span asp-validation-for="Email" class="text-danger"></span>
        <label>
            <input asp-for="IsActive" type="checkbox" />
            Active
        </label>

        <div class="d-flex gap-2">
            <button type="submit" class="btn-primary">Save</button>
            <a asp-action="Manage" class="btn btn-secondary">Back</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
