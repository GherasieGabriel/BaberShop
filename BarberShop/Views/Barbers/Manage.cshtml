@model ManageBarbersViewModel
@{
    Layout = "_BarberLayout";
    ViewData["Title"] = "Manage Barbers";
}

<h1 class="mb-3">Manage Barbers</h1>

@if (TempData["BookingSuccess"] is not null)
{
    <div class="alert alert-success">@TempData["BookingSuccess"]</div>
}
@if (TempData["BookingError"] is not null)
{
    <div class="alert alert-danger">@TempData["BookingError"]</div>
}

<section class="mb-4">
    <h2>Add Barber</h2>
    <form method="post" asp-action="Create" class="booking-form">
        @Html.AntiForgeryToken()
        <label>First Name <input name="FirstName" type="text" value="@Model.NewBarber.FirstName" /></label>
        <label>Last Name <input name="LastName" type="text" value="@Model.NewBarber.LastName" /></label>
        <label>Phone <input name="Phone" type="text" value="@Model.NewBarber.Phone" /></label>
        <label>Email <input name="Email" type="email" value="@Model.NewBarber.Email" /></label>
        <label><input name="IsActive" type="checkbox" value="true" /> Active</label>
        <button type="submit" class="btn-primary">Create</button>
    </form>
</section>

<section>
    <h2>Barbers</h2>
    <div class="row">
        @foreach (var barber in Model.Barbers.OrderBy(b => b.FirstName).ThenBy(b => b.LastName))
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="product-card">
                    <h3>@barber.FirstName @barber.LastName</h3>
                    <p>@barber.Phone</p>
                    <p>@barber.Email</p>
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-email="@barber.Email" class="btn-primary">Edit</a>
                        <form method="post" asp-action="Delete" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="email" value="@barber.Email" />
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
