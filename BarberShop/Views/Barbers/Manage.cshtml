@model ManageBarbersViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Manage Barbers";
}

<div class="container mt-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Manage Barbers</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">View Barbers</a>
    </div>

    @if (TempData["BookingSuccess"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["BookingSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["BookingError"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["BookingError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-lg-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Add New Barber</h5>
                </div>
                <div class="card-body">
                    <form method="post" asp-action="Create" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label">First Name</label>
                            <input name="FirstName" type="text" class="form-control" placeholder="John" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Last Name</label>
                            <input name="LastName" type="text" class="form-control" placeholder="Doe" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Phone</label>
                            <input name="Phone" type="text" class="form-control" placeholder="+1 (555) 000-0000" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input name="Email" type="email" class="form-control" placeholder="john@example.com" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Photo</label>
                            <input type="file" name="photo" class="form-control" accept="image/*" />
                            <small class="text-muted">JPG, PNG, GIF (max 5MB)</small>
                        </div>
                        <div class="mb-3 form-check">
                            <input name="IsActive" type="checkbox" class="form-check-input" value="true" id="isActive" checked />
                            <label class="form-check-label" for="isActive">Active</label>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Add Barber</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <h5 class="mb-3">Current Barbers</h5>
            @if (!Model.Barbers.Any())
            {
                <div class="alert alert-info">No barbers found. Create your first barber to get started.</div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var barber in Model.Barbers.OrderBy(b => b.FirstName).ThenBy(b => b.LastName))
                    {
                        <div class="col-md-6">
                            <div class="card shadow-sm h-100">
                                @if (!string.IsNullOrEmpty(barber.PhotoFileName))
                                {
                                    <img src="~/images/barbers/@barber.PhotoFileName" alt="@barber.FirstName" class="card-img-top" style="height: 200px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                        <i class="bi bi-image" style="font-size: 3rem; color: #ccc;"></i>
                                    </div>
                                }
                                <div class="card-body">
                                    <h5 class="card-title">@barber.FirstName @barber.LastName</h5>
                                    <p class="card-text text-muted small">
                                        <i class="bi bi-telephone"></i> @barber.Phone<br />
                                        <i class="bi bi-envelope"></i> @barber.Email
                                    </p>
                                    <div class="d-flex gap-2">
                                        <a asp-action="Edit" asp-route-email="@barber.Email" class="btn btn-sm btn-warning">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <form method="post" asp-action="Delete" class="d-inline" onsubmit="return confirm('Are you sure?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="email" value="@barber.Email" />
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
