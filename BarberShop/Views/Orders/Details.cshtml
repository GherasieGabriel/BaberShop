@model BarberShop.Models.Order

@{
    Layout = "_Layout";
    ViewData["Title"] = $"Order #{Model.OrderId}";
}

<div class="container mt-5 mb-5">
    <div class="row">
        <div class="col-lg-8">
            <h1 class="mb-4">Order #@Model.OrderId</h1>

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Order Summary</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <p><strong>Order Date:</strong> @Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
                            <p><strong>Customer:</strong> @Model.CustomerName</p>
                            <p><strong>Email:</strong> @Model.CustomerEmail</p>
                        </div>
                        <div class="col-md-6 text-end">
                            <p>
                                <strong>Status:</strong>
                                <span class="badge bg-@(Model.Status == "Pending" ? "warning" : Model.Status == "Completed" ? "success" : "danger") fs-6">
                                    @Model.Status
                                </span>
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Items Ordered</h5>
                </div>
                <div class="card-body">
                    @if (!Model.Items.Any())
                    {
                        <p class="text-muted">No items in this order.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var item in Model.Items)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@item.Name</strong>
                                        <div class="text-muted small">Qty: @item.Quantity</div>
                                    </div>
                                    <div class="text-end">
                                        <div>@item.UnitPrice.ToString("C2") each</div>
                                        <div class="fw-bold">@item.Total.ToString("C2")</div>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm sticky-top">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Order Total</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal:</span>
                        <span>@Model.TotalAmount.ToString("C2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span>Shipping:</span>
                        <span>Free</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between fs-5 fw-bold">
                        <span>Grand Total:</span>
                        <span>@Model.TotalAmount.ToString("C2")</span>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <a asp-action="Index" class="btn btn-secondary w-100">Back to Orders</a>
            </div>
        </div>
    </div>
</div>
