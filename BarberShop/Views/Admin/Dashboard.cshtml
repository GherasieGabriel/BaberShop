@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_Layout";
}

<div class="container mt-5 mb-5">
    <div class="row">
        <div class="col-md-3">
            <div class="list-group">
                <a asp-action="Dashboard" class="list-group-item list-group-item-action active">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
                <a asp-action="Orders" class="list-group-item list-group-item-action">
                    <i class="bi bi-box-seam"></i> Orders
                </a>
                <a asp-action="Users" class="list-group-item list-group-item-action">
                    <i class="bi bi-people"></i> Manage Users
                </a>
                <a asp-controller="Products" asp-action="Manage" class="list-group-item list-group-item-action">
                    <i class="bi bi-box"></i> Manage Products
                </a>
                <a asp-controller="Services" asp-action="Manage" class="list-group-item list-group-item-action">
                    <i class="bi bi-scissors"></i> Manage Services
                </a>
                <a asp-controller="Barbers" asp-action="Manage" class="list-group-item list-group-item-action">
                    <i class="bi bi-person-badge"></i> Manage Barbers
                </a>
                <a asp-action="Messages" class="list-group-item list-group-item-action">
                    <i class="bi bi-envelope"></i> Contact Messages
                </a>
            </div>
        </div>

        <div class="col-md-9">
            <div class="card shadow-lg">
                <div class="card-header bg-dark text-light">
                    <h5 class="mb-0"><i class="bi bi-speedometer2 me-2"></i>Admin Dashboard</h5>
                </div>
                <div class="card-body">
                    <h6 class="mb-3">Welcome to the BarberShop Admin Panel</h6>
                    <p class="text-muted mb-5">
                        Use the menu on the left to manage orders, users, products, services, barbers, and view contact messages.
                    </p>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="card bg-danger text-white h-100 border-0">
                                <div class="card-body">
                                    <h6 class="card-title">
                                        <i class="bi bi-box-seam me-2"></i> Orders Management
                                    </h6>
                                    <p class="card-text small">View, track, and manage customer orders.</p>
                                    <a asp-action="Orders" class="btn btn-light btn-sm">View Orders</a>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card bg-primary text-white h-100 border-0">
                                <div class="card-body">
                                    <h6 class="card-title">
                                        <i class="bi bi-people me-2"></i> User Management
                                    </h6>
                                    <p class="card-text small">Manage users, assign roles, and control access.</p>
                                    <a asp-action="Users" class="btn btn-light btn-sm">View Users</a>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card bg-success text-white h-100 border-0">
                                <div class="card-body">
                                    <h6 class="card-title">
                                        <i class="bi bi-box me-2"></i> Product Management
                                    </h6>
                                    <p class="card-text small">Add, edit, and manage barber products.</p>
                                    <a asp-controller="Products" asp-action="Manage" class="btn btn-light btn-sm">View Products</a>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card bg-warning text-dark h-100 border-0">
                                <div class="card-body">
                                    <h6 class="card-title">
                                        <i class="bi bi-scissors me-2"></i> Service Management
                                    </h6>
                                    <p class="card-text small">Configure barber services and pricing.</p>
                                    <a asp-controller="Services" asp-action="Manage" class="btn btn-dark btn-sm">View Services</a>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card bg-info text-white h-100 border-0">
                                <div class="card-body">
                                    <h6 class="card-title">
                                        <i class="bi bi-person-badge me-2"></i> Barber Management
                                    </h6>
                                    <p class="card-text small">Manage barber staff and availability.</p>
                                    <a asp-controller="Barbers" asp-action="Manage" class="btn btn-light btn-sm">View Barbers</a>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card bg-secondary text-white h-100 border-0">
                                <div class="card-body">
                                    <h6 class="card-title">
                                        <i class="bi bi-envelope me-2"></i> Contact Messages
                                    </h6>
                                    <p class="card-text small">View and respond to customer messages.</p>
                                    <a asp-action="Messages" class="btn btn-light btn-sm">View Messages</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
