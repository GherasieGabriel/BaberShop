@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_Layout";
}

<div class="container mt-5 mb-5">
    <div class="row">
        <div class="col-md-3">
            <div class="list-group">
                <a asp-action="Dashboard" class="list-group-item list-group-item-action active">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
                <a asp-action="Users" class="list-group-item list-group-item-action">
                    <i class="bi bi-people"></i> Manage Users
                </a>
                <a asp-controller="Products" asp-action="Manage" class="list-group-item list-group-item-action">
                    <i class="bi bi-box"></i> Manage Products
                </a>
                <a asp-controller="Services" asp-action="Manage" class="list-group-item list-group-item-action">
                    <i class="bi bi-scissors"></i> Manage Services
                </a>
                <a asp-controller="Barbers" asp-action="Manage" class="list-group-item list-group-item-action">
                    <i class="bi bi-person-badge"></i> Manage Barbers
                </a>
                <a asp-action="Messages" class="list-group-item list-group-item-action">
                    <i class="bi bi-envelope"></i> Contact Messages
                </a>
            </div>
        </div>

        <div class="col-md-9">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Admin Dashboard</h5>
                </div>
                <div class="card-body">
                    <h6>Welcome to the BarberShop Admin Panel</h6>
                    <p class="text-muted mb-4">
                        Use the menu on the left to manage users, products, services, barbers, and view contact messages.
                    </p>

                    <div class="row g-4 mt-3">
                        <div class="col-md-6">
                            <div class="card bg-primary text-white">
                                <div class="card-body">
                                    <h6 class="card-title">
                                        <i class="bi bi-people"></i> User Management
                                    </h6>
                                    <p class="card-text">Manage users, assign roles, and control access permissions.</p>
                                    <a asp-action="Users" class="btn btn-light btn-sm">Go to Users</a>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card bg-success text-white">
                                <div class="card-body">
                                    <h6 class="card-title">
                                        <i class="bi bi-box"></i> Product Management
                                    </h6>
                                    <p class="card-text">Add, edit, and manage barber products and inventory.</p>
                                    <a asp-controller="Products" asp-action="Manage" class="btn btn-light btn-sm">Go to Products</a>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card bg-warning text-white">
                                <div class="card-body">
                                    <h6 class="card-title">
                                        <i class="bi bi-scissors"></i> Service Management
                                    </h6>
                                    <p class="card-text">Configure barber services, prices, and availability.</p>
                                    <a asp-controller="Services" asp-action="Manage" class="btn btn-light btn-sm">Go to Services</a>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card bg-danger text-white">
                                <div class="card-body">
                                    <h6 class="card-title">
                                        <i class="bi bi-person-badge"></i> Barber Management
                                    </h6>
                                    <p class="card-text">Manage barber staff and their availability.</p>
                                    <a asp-controller="Barbers" asp-action="Manage" class="btn btn-light btn-sm">Go to Barbers</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
