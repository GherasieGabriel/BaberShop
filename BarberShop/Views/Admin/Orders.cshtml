@model List<BarberShop.Models.Order>

@{
    ViewData["Title"] = "Order Management";
    Layout = "_Layout";
}

<div class="container-fluid mt-5 mb-5">
    <div class="row">
        <div class="col-md-3">
            <div class="card shadow-lg border-0 sticky-top">
                <div class="card-header bg-dark text-light fw-bold">
                    <i class="bi bi-speedometer2"></i> Admin Menu
                </div>
                <div class="list-group list-group-flush">
                    <a asp-action="Dashboard" class="list-group-item list-group-item-action">
                        <i class="bi bi-house"></i> Dashboard
                    </a>
                    <a asp-action="Orders" class="list-group-item list-group-item-action active">
                        <i class="bi bi-box-seam"></i> Orders
                    </a>
                    <a asp-action="Users" class="list-group-item list-group-item-action">
                        <i class="bi bi-people"></i> Users
                    </a>
                    <a asp-controller="Products" asp-action="Manage" class="list-group-item list-group-item-action">
                        <i class="bi bi-box"></i> Products
                    </a>
                    <a asp-controller="Services" asp-action="Manage" class="list-group-item list-group-item-action">
                        <i class="bi bi-scissors"></i> Services
                    </a>
                    <a asp-controller="Barbers" asp-action="Manage" class="list-group-item list-group-item-action">
                        <i class="bi bi-person-badge"></i> Barbers
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-danger text-light">
                    <h5 class="mb-0"><i class="bi bi-box-seam me-2"></i>Order Management</h5>
                </div>
                <div class="card-body p-4">
                    @if (!Model.Any())
                    {
                        <div class="alert alert-info text-center py-5">
                            <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                            <p class="mt-3">No orders yet. The shop is waiting for its first customer!</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-striped">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Order ID</th>
                                        <th>Customer</th>
                                        <th>Email</th>
                                        <th>Items</th>
                                        <th>Total</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>#@order.OrderId</strong>
                                            </td>
                                            <td>@order.CustomerName</td>
                                            <td>
                                                <small class="text-muted">@order.CustomerEmail</small>
                                            </td>
                                            <td>
                                                <span class="badge bg-info">@order.Items.Count</span>
                                            </td>
                                            <td>
                                                <strong class="text-success">@order.TotalAmount.ToString("C2")</strong>
                                            </td>
                                            <td>@order.CreatedAt.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                <span class="badge bg-@(order.Status == "Pending" ? "warning" : order.Status == "Completed" ? "success" : "danger")">
                                                    @order.Status
                                                </span>
                                            </td>
                                            <td>
                                                <a href="#" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#orderModal@order.OrderId">
                                                    <i class="bi bi-eye"></i> View
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Summary Stats -->
                        <div class="row mt-5 g-3">
                            <div class="col-md-4">
                                <div class="card bg-primary text-white text-center">
                                    <div class="card-body">
                                        <h6 class="card-title">Total Orders</h6>
                                        <h2 class="mb-0">@Model.Count</h2>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card bg-success text-white text-center">
                                    <div class="card-body">
                                        <h6 class="card-title">Total Revenue</h6>
                                        <h2 class="mb-0">@Model.Sum(o => o.TotalAmount).ToString("C0")</h2>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card bg-warning text-white text-center">
                                    <div class="card-body">
                                        <h6 class="card-title">Average Order</h6>
                                        <h2 class="mb-0">@(Model.Any() ? Model.Average(o => o.TotalAmount).ToString("C0") : "$0")</h2>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Order Detail Modals -->
            @foreach (var order in Model)
            {
                <div class="modal fade" id="orderModal@order.OrderId" tabindex="-1">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                            <div class="modal-header bg-dark text-light">
                                <h5 class="modal-title">Order #@order.OrderId Details</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="row mb-4">
                                    <div class="col-md-6">
                                        <strong>Customer:</strong> @order.CustomerName<br/>
                                        <strong>Email:</strong> @order.CustomerEmail<br/>
                                        <strong>Order Date:</strong> @order.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                    </div>
                                    <div class="col-md-6 text-end">
                                        <strong>Status:</strong> 
                                        <span class="badge bg-@(order.Status == "Pending" ? "warning" : order.Status == "Completed" ? "success" : "danger")">
                                            @order.Status
                                        </span>
                                        <br/>
                                        <strong class="text-success">Total: @order.TotalAmount.ToString("C2")</strong>
                                    </div>
                                </div>

                                <h6 class="mb-3">Items Ordered:</h6>
                                <div class="table-responsive">
                                    <table class="table table-sm">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Product</th>
                                                <th>Unit Price</th>
                                                <th>Qty</th>
                                                <th>Total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in order.Items)
                                            {
                                                <tr>
                                                    <td>@item.Name</td>
                                                    <td>@item.UnitPrice.ToString("C2")</td>
                                                    <td>@item.Quantity</td>
                                                    <td>@item.Total.ToString("C2")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
