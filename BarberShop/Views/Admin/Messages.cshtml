@model AdminInboxViewModel
@{
    ViewData["Title"] = "Admin Inbox";
    Layout = "_Layout";
}

<div class="container mt-5 mb-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h1 class="mb-1">Admin Inbox</h1>
            <p class="text-muted mb-0">Review contact messages, mark them as read, and remove resolved items.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Messages" asp-route-unreadOnly="false" class="btn @(Model.UnreadOnly ? "btn-outline-primary" : "btn-primary")">
                All messages (@Model.TotalCount)
            </a>
            <a asp-action="Messages" asp-route-unreadOnly="true" class="btn @(Model.UnreadOnly ? "btn-primary" : "btn-outline-primary")">
                Unread (@Model.UnreadCount)
            </a>
        </div>
    </div>

    @if (Model.Messages.Count == 0)
    {
        <div class="alert alert-info">There are no messages to display.</div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-4">
                <div class="list-group shadow-sm">
                    @foreach (var message in Model.Messages)
                    {
                        var active = Model.SelectedMessageId == message.MessageId;
                        <a asp-action="Messages"
                           asp-route-selectedMessageId="@message.MessageId"
                           asp-route-unreadOnly="@Model.UnreadOnly"
                           class="list-group-item list-group-item-action @(active ? "active" : string.Empty)">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <div class="fw-semibold">@message.Subject</div>
                                    <small class="@(active ? "text-white-50" : "text-muted")">@message.SenderName</small>
                                </div>
                                <span class="badge @(message.IsRead ? "bg-success" : "bg-warning text-dark")">
                                    @(message.IsRead ? "Read" : "Unread")
                                </span>
                            </div>
                            <div class="small mt-2 @(active ? "text-white-50" : "text-muted")">@message.Preview</div>
                            <div class="small mt-2 @(active ? "text-white-50" : "text-muted")">@message.CreatedAt.ToLocalTime().ToString("MMM d, yyyy HH:mm")</div>
                        </a>
                    }
                </div>
            </div>

            <div class="col-lg-8">
                @if (Model.SelectedMessage is null)
                {
                    <div class="card shadow-sm h-100">
                        <div class="card-body d-flex align-items-center justify-content-center">
                            <p class="text-muted mb-0">Select a message to view the full conversation details.</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card shadow-sm">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                                <div>
                                    <h2 class="h4 mb-1">@Model.SelectedMessage.Subject</h2>
                                    <div class="text-muted">
                                        From <strong>@Model.SelectedMessage.SenderName</strong>
                                        @if (!string.IsNullOrWhiteSpace(Model.SelectedMessage.SenderEmail))
                                        {
                                            <span>(@Model.SelectedMessage.SenderEmail)</span>
                                        }
                                    </div>
                                    <div class="text-muted">@Model.SelectedMessage.CreatedAt.ToLocalTime().ToString("dddd, MMMM d, yyyy h:mm tt")</div>
                                </div>
                                <span class="badge @(Model.SelectedMessage.IsRead ? "bg-success" : "bg-warning text-dark") fs-6">
                                    @(Model.SelectedMessage.IsRead ? "Read" : "Unread")
                                </span>
                            </div>

                            <div class="border rounded p-3 bg-light mb-4" style="white-space: pre-wrap;">@Model.SelectedMessage.Message</div>

                            <div class="d-flex flex-wrap gap-2">
                                @if (!Model.SelectedMessage.IsRead)
                                {
                                    <form asp-action="MarkMessageRead" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="messageId" value="@Model.SelectedMessage.MessageId" />
                                        <input type="hidden" name="unreadOnly" value="@Model.UnreadOnly" />
                                        <button type="submit" class="btn btn-success">Mark as read</button>
                                    </form>
                                }

                                <form asp-action="DeleteMessage" method="post" onsubmit="return confirm('Delete this message from the inbox?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="messageId" value="@Model.SelectedMessage.MessageId" />
                                    <input type="hidden" name="unreadOnly" value="@Model.UnreadOnly" />
                                    <button type="submit" class="btn btn-outline-danger">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
