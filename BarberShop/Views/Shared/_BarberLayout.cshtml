@inject BarberShop.Services.Interfaces.IAdminAccessService adminAccessService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BarberShop</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-3">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">BarberShop</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNavbar">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Services" asp-action="Index">Services</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Barbers" asp-action="Index">Barbers</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Appointments" asp-action="Booking">Book Now</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Index">Products</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Prices">Prices</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Gallery">Gallery</a></li>
            </ul>

            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Appointments" asp-action="Profile" class="btn btn-outline-warning btn-sm">Profile</a>

                @if (adminAccessService.IsAdmin())
                {
                    <span class="text-warning small fw-bold">Admin mode</span>
                    <form method="post" asp-controller="Admin" asp-action="Logout" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-warning btn-sm">Logout</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Admin" asp-action="Login" class="btn btn-outline-light btn-sm">Admin Login</a>
                }
            </div>
        </div>
    </nav>
</header>

<main>
    @RenderBody()
</main>

<footer>
    <p>2026 Barber-Shop.</p>
</footer>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
