@{
    Layout = "_BarberLayout";
    ViewData["Title"] = "Profile";
}

<section class="profile-header">
    <h1 class="profile-name">Admin</h1>
    <p class="profile-email">admin@yahoo.com</p>
</section>

<div class="profile-container">
    <div class="profile-section">
        <h2 class="section-title">Personal Information</h2>
        <div class="info-row"><span class="info-label">Full Name:</span><span class="info-value">Admin</span></div>
        <div class="info-row"><span class="info-label">Email:</span><span class="info-value">admin@yahoo.com</span></div>
        <div class="info-row"><span class="info-label">Phone:</span><span class="info-value">+407--------</span></div>
        <div class="info-row"><span class="info-label">Member Since:</span><span class="info-value">January 15, 2026</span></div>
    </div>

    <div class="profile-section">
        <h2 class="section-title">Upcoming Appointments</h2>
        <div class="booking-item"><div class="booking-date">March 10, 2026 - 2:30 PM</div><div class="booking-details"><strong>Service:</strong> Haircut + Beard Trim<br><strong>Barber:</strong> Mike Johnson<br><strong>Duration:</strong> 45 minutes</div></div>
        <div class="booking-item"><div class="booking-date">March 17, 2026 - 4:00 PM</div><div class="booking-details"><strong>Service:</strong> Classic Fade<br><strong>Barber:</strong> Alex Smith<br><strong>Duration:</strong> 30 minutes</div></div>
    </div>

    <div class="profile-section">
        <h2 class="section-title">Past Bookings</h2>
        <div class="booking-item"><div class="booking-date">March 3, 2026 - 1:00 PM</div><div class="booking-details"><strong>Service:</strong> Haircut<br><strong>Barber:</strong> Mike Johnson<br><strong>Duration:</strong> 30 minutes</div></div>
        <div class="booking-item"><div class="booking-date">February 24, 2026 - 3:30 PM</div><div class="booking-details"><strong>Service:</strong> Beard Trim + Line Up<br><strong>Barber:</strong> Alex Smith<br><strong>Duration:</strong> 25 minutes</div></div>
    </div>

    <div class="profile-section">
        <h2 class="section-title">Account Settings</h2>
        <div class="info-row"><span class="info-label">Notifications:</span><span class="info-value">Email & SMS</span></div>
        <div class="info-row"><span class="info-label">Privacy:</span><span class="info-value">Public Profile</span></div>
        <div class="info-row"><span class="info-label">Two-Factor Authentication:</span><span class="info-value">Disabled</span></div>
    </div>
</div>
