@{
    Layout = "_Layout";
    ViewData["Title"] = "Gallery";
}

<section class="hero">
    <h1>Gallery</h1>
    <p>Modern cuts, classic style. Book your next appointment in seconds.</p>
    <a asp-controller="Appointments" asp-action="Booking" class="btn btn-primary">Book an appointment</a>
</section>

<section class="gallery-container mt-5 mb-5">
    <h2 class="text-center mb-4">Recent Styles</h2>

    <div class="row">
        <div class="col-md-6 col-lg-4 mb-4">
            <img src="https://images.unsplash.com/photo-1517832606299-7ae9b720a186?auto=format&fit=crop&w=900&q=80" alt="Modern Undercut" class="gallery-image" />
            <h4 class="mt-2">Modern Undercut</h4>
        </div>
        <div class="col-md-6 col-lg-4 mb-4">
            <img src="https://images.unsplash.com/photo-1503951914875-452162b0f3f1?auto=format&fit=crop&w=900&q=80" alt="Classic Fade" class="gallery-image" />
            <h4 class="mt-2">Classic Fade</h4>
        </div>
        <div class="col-md-6 col-lg-4 mb-4">
            <img src="https://images.unsplash.com/photo-1622286342621-4bd786c2447c?auto=format&fit=crop&w=900&q=80" alt="Sharp Lineup" class="gallery-image" />
            <h4 class="mt-2">Sharp Lineup</h4>
        </div>
        <div class="col-md-6 col-lg-4 mb-4">
            <img src="https://images.unsplash.com/photo-1621605815971-fbc98d665033?auto=format&fit=crop&w=900&q=80" alt="Beard Styling" class="gallery-image" />
            <h4 class="mt-2">Beard Styling</h4>
        </div>
        <div class="col-md-6 col-lg-4 mb-4">
            <img src="https://images.unsplash.com/photo-1532710093739-9470acff878f?auto=format&fit=crop&w=900&q=80" alt="Premium Grooming" class="gallery-image" />
            <h4 class="mt-2">Premium Grooming</h4>
        </div>
        <div class="col-md-6 col-lg-4 mb-4">
            <img src="https://images.unsplash.com/photo-1585747860715-2ba37e788b70?auto=format&fit=crop&w=900&q=80" alt="Skin Fade" class="gallery-image" />
            <h4 class="mt-2">Skin Fade</h4>
        </div>
    </div>
</section>
