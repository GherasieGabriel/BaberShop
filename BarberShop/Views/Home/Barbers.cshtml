@model List<Barber>
@inject BarberShop.Services.Interfaces.IAdminAccessService adminAccessService

@{
    Layout = "_BarberLayout";
    ViewData["Title"] = "Barbers";

    string ImageFor(string firstName)
    {
        return firstName switch
        {
            "Johny" => Url.Content("~/images/barbers/johny-mcbarber.jpg"),
            "Andrei" => Url.Content("~/images/barbers/andrei-barberescu.jpg"),
            "Mihai" => Url.Content("~/images/barbers/mihai-brici.jpg"),
            "Dorel" => Url.Content("~/images/barbers/dorel-centuristul.jpg"),
            "Stephany" => Url.Content("~/images/barbers/stephany-shearing.jpg"),
            _ => Url.Content("~/images/barbers/default-barber.jpg")
        };
    }
}

<h1>Our Team</h1>

@if (TempData["BookingSuccess"] is not null)
{
    <div class="alert alert-success">@TempData["BookingSuccess"]</div>
}

@if (TempData["BookingError"] is not null)
{
    <div class="alert alert-danger">@TempData["BookingError"]</div>
}

<div class="row">
    @foreach (var barber in Model.Where(b => b.IsActive).OrderBy(b => b.FirstName).ThenBy(b => b.LastName))
    {
        <div class="col-md-6 col-lg-4 mb-4">
            <img src="@ImageFor(barber.FirstName)" alt="@($"{barber.FirstName} {barber.LastName}")" class="barber-image" />
            <h3>@barber.FirstName @barber.LastName</h3>
            <p>@(!string.IsNullOrWhiteSpace(barber.Phone) ? barber.Phone : "-")</p>
            @if (adminAccessService.IsAdmin())
            {
                <a href="/Barbers/Edit/@barber.BarberId" class="btn btn-primary btn-sm">Edit</a>
            }
        </div>
    }
</div>

@if (adminAccessService.IsAdmin())
{
    <div class="text-center mt-5">
        <a href="/Barbers/Manage" class="btn-primary">Manage Barbers</a>
    </div>
}
