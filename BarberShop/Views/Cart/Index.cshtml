@model ShoppingCart

@{
    Layout = "_Layout";
    ViewData["Title"] = "Shopping Cart";
}

<style>
    .cart-container {
        max-width: 1000px;
        margin: 40px auto;
        padding: 20px;
    }

    .cart-header {
        margin-bottom: 30px;
    }

    .cart-header h1 {
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .cart-empty {
        text-align: center;
        padding: 60px 20px;
        background: #f8f9fa;
        border-radius: 8px;
    }

    .cart-empty h2 {
        color: #999;
        font-size: 24px;
        margin-bottom: 20px;
    }

    .cart-empty p {
        color: #666;
        font-size: 16px;
        margin-bottom: 30px;
    }

    .cart-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 30px;
        background: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .cart-table thead {
        background: #f8f9fa;
        border-bottom: 2px solid #dee2e6;
    }

    .cart-table th {
        padding: 16px;
        text-align: left;
        font-weight: 600;
        color: #333;
    }

    .cart-table td {
        padding: 16px;
        border-bottom: 1px solid #dee2e6;
    }

    .product-name {
        font-weight: 600;
        color: #333;
    }

    .product-price {
        color: #666;
        font-weight: 500;
    }

    .quantity-input {
        width: 70px;
        padding: 8px;
        border: 1px solid #ddd;
        border-radius: 4px;
        text-align: center;
    }

    .item-total {
        font-weight: 600;
        color: #333;
    }

    .remove-btn {
        background: #dc3545;
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 4px;
        cursor: pointer;
        font-size: 13px;
    }

    .remove-btn:hover {
        background: #c82333;
    }

    .cart-summary {
        background: #f8f9fa;
        padding: 30px;
        border-radius: 8px;
        max-width: 400px;
        margin-left: auto;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 16px;
        font-size: 16px;
    }

    .summary-row.total {
        border-top: 2px solid #dee2e6;
        padding-top: 16px;
        font-weight: 700;
        font-size: 18px;
        color: #333;
    }

    .btn-checkout {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        padding: 14px 40px;
        border-radius: 8px;
        font-weight: 600;
        width: 100%;
        cursor: pointer;
        margin-top: 20px;
        font-size: 16px;
    }

    .btn-checkout:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 20px rgba(102, 126, 234, 0.4);
        color: white;
    }

    .btn-continue {
        background: white;
        color: #667eea;
        border: 2px solid #667eea;
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        margin-bottom: 20px;
    }

    .btn-continue:hover {
        background: #f8f9fa;
    }

    .btn-clear {
        background: #e9ecef;
        color: #666;
        border: none;
        padding: 10px 20px;
        border-radius: 4px;
        cursor: pointer;
        font-weight: 500;
    }

    .btn-clear:hover {
        background: #dee2e6;
    }
</style>

<div class="cart-container">
    <div class="cart-header">
        <h1>Shopping Cart</h1>
        <p class="text-muted">Review your items and proceed to checkout</p>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="cart-empty">
            <h2>Your cart is empty</h2>
            <p>Explore our collection of premium barber products</p>
            <a href="@Url.Action("Index", "Home", new { area = "" })" class="btn-continue">
                Continue Shopping
            </a>
        </div>
    }
    else
    {
        <table class="cart-table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <span class="product-name">@item.Name</span>
                        </td>
                        <td>
                            <span class="product-price">$@item.Price.ToString("F2")</span>
                        </td>
                        <td>
                            <form method="post" asp-action="Update" style="display: flex; gap: 8px; align-items: center;">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="number" name="quantity" value="@item.Quantity" min="1" class="quantity-input" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Update</button>
                            </form>
                        </td>
                        <td>
                            <span class="item-total">$@item.Total.ToString("F2")</span>
                        </td>
                        <td>
                            <form method="post" asp-action="Remove" style="display: inline;">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="remove-btn">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 30px;">
            <div>
                <a href="@Url.Action("Index", "Home", new { area = "" })" class="btn-continue">
                    ← Continue Shopping
                </a>
                <form method="post" asp-action="Clear" style="display: inline;">
                    <button type="submit" class="btn-clear" style="margin-left: 10px;">Clear Cart</button>
                </form>
            </div>

            <div class="cart-summary">
                <div class="summary-row">
                    <span>Subtotal:</span>
                    <span>$@Model.GetTotal().ToString("F2")</span>
                </div>
                <div class="summary-row">
                    <span>Shipping:</span>
                    <span>Free</span>
                </div>
                <div class="summary-row total">
                    <span>Total:</span>
                    <span>$@Model.GetTotal().ToString("F2")</span>
                </div>
                <a asp-action="Checkout" class="btn-checkout">Proceed to Checkout</a>
            </div>
        </div>
    }
</div>
