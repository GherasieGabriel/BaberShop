@model BookingViewModel
@{
    Layout = "_BarberLayout";
    ViewData["Title"] = "Booking";
}

<h1 class="text-center mb-3">Book an appointment</h1>

@if (TempData["BookingSuccess"] is not null)
{
    <div class="alert alert-success">@TempData["BookingSuccess"]</div>
}

@if (TempData["BookingError"] is not null)
{
    <div class="alert alert-danger">@TempData["BookingError"]</div>
}

<form class="booking-form" method="post" asp-action="Booking">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <label>
        Full name:
        <input asp-for="FullName" type="text" required />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </label>

    <label>
        Email:
        <input asp-for="Email" type="email" required />
        <span asp-validation-for="Email" class="text-danger"></span>
    </label>

    <label>
        Service:
        <select asp-for="Service" asp-items="new SelectList(Model.AvailableServices)" required></select>
        <span asp-validation-for="Service" class="text-danger"></span>
    </label>

    <label>
        Barber:
        <select asp-for="Barber" asp-items="new SelectList(Model.AvailableBarbers)" required></select>
        <span asp-validation-for="Barber" class="text-danger"></span>
    </label>

    <label>
        Date:
        <input asp-for="Date" type="date" required />
        <span asp-validation-for="Date" class="text-danger"></span>
    </label>

    <label>
        Time:
        <input asp-for="Time" type="time" required />
        <span asp-validation-for="Time" class="text-danger"></span>
    </label>

    <label>
        Notes:
        <textarea asp-for="Notes" rows="3" placeholder="Optional"></textarea>
        <span asp-validation-for="Notes" class="text-danger"></span>
    </label>

    <button type="submit" class="btn-primary">Submit reservation</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
