@{
    ViewData["Title"] = "Appointment Calendar";
}

<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/main.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/main.min.js"></script>

<div class="container mt-4">
    <h2>Appointment Calendar</h2>
    <p>Click a timeslot to create a booking (you will be redirected to the booking form with prefilled values).</p>
    <div id="calendar"></div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var calendarEl = document.getElementById('calendar');

        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,timeGridDay'
            },
            selectable: true,
            selectMirror: true,
            select: function (arg) {
                // Redirect to booking form with prefilled date/time (ISO)
                var start = arg.start;
                var date = start.toISOString().split('T')[0];
                var time = start.toTimeString().split(' ')[0].substring(0,5); // HH:mm

                // Build query params
                var params = new URLSearchParams();
                params.set('date', date);
                params.set('time', time);
                // If user selected a range, we could set duration, but the booking form selects service which determines duration

                // Redirect to the Booking action
                window.location.href = '/Appointments/Booking?' + params.toString();
            },
            eventClick: function(info) {
                // Optionally show event details
                alert(info.event.title + '\n' + info.event.start.toLocaleString());
            },
            events: '/Appointments/GetAppointmentsJson'
        });

        calendar.render();
    });
</script>
