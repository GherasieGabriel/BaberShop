@model AppointmentConfirmationViewModel
@{
    Layout = "_BarberLayout";
    ViewData["Title"] = "Appointment Confirmation";

    var appointment = Model.Appointment;
    var barberName = $"{appointment.Barber.FirstName} {appointment.Barber.LastName}".Trim();
}

<section class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <h1 class="mt-3">Appointment confirmed</h1>
                        <p class="text-muted mb-0">@Model.Message</p>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <strong>Service:</strong><br />
                            @appointment.Service.Name
                        </div>
                        <div class="col-md-6">
                            <strong>Barber:</strong><br />
                            @barberName
                        </div>
                        <div class="col-md-6">
                            <strong>Date:</strong><br />
                            @appointment.StartDateTime.ToLocalTime().ToString("dddd, MMMM d, yyyy")
                        </div>
                        <div class="col-md-6">
                            <strong>Time:</strong><br />
                            @appointment.StartDateTime.ToLocalTime().ToString("h:mm tt")
                        </div>
                        <div class="col-12">
                            <strong>Status:</strong><br />
                            @appointment.Status
                        </div>
                        @if (!string.IsNullOrWhiteSpace(appointment.Notes))
                        {
                            <div class="col-12">
                                <strong>Notes:</strong><br />
                                @appointment.Notes
                            </div>
                        }
                    </div>

                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                        <a class="btn btn-primary" asp-controller="Payments" asp-action="Create" asp-route-appointmentId="@appointment.AppointmentId">Proceed to payment</a>
                        <a class="btn btn-outline-secondary" asp-controller="Appointments" asp-action="Profile" asp-route-selectedAppointmentId="@appointment.AppointmentId">View in profile</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
