@model ManageServicesViewModel
@{
    Layout = "_BarberLayout";
    ViewData["Title"] = "Manage Services";
}

<h1 class="mb-3">Manage Services</h1>

@if (TempData["BookingSuccess"] is not null)
{
    <div class="alert alert-success">@TempData["BookingSuccess"]</div>
}
@if (TempData["BookingError"] is not null)
{
    <div class="alert alert-danger">@TempData["BookingError"]</div>
}

<section class="mb-4">
    <h2>Add Service</h2>
    <form method="post" asp-action="Create" class="booking-form">
        @Html.AntiForgeryToken()
        <label>Name <input name="Name" type="text" value="@Model.NewService.Name" /></label>
        <label>Description <textarea name="Description" rows="2">@Model.NewService.Description</textarea></label>
        <label>Duration (minutes) <input name="BaseDuration" type="number" min="1" value="@Model.NewService.BaseDuration" /></label>
        <label>Base Price <input name="BasePrice" type="number" step="0.01" min="0" value="@Model.NewService.BasePrice" /></label>
        <label><input name="IsActive" type="checkbox" value="true" /> Active</label>
        <button type="submit" class="btn-primary">Create</button>
    </form>
</section>

<section class="products-container">
    <h2>Services List</h2>
    <div class="row">
        @foreach (var service in Model.Services.OrderBy(s => s.Name))
        {
            <div class="col-md-6 col-lg-4">
                <div class="product-card">
                    <h3 class="product-name">@service.Name</h3>
                    <p class="product-description">@(string.IsNullOrWhiteSpace(service.Description) ? "-" : service.Description)</p>
                    <div class="product-price">@service.BasePrice.ToString("0.00") RON • @service.BaseDuration min</div>
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-name="@service.Name" class="btn-primary">Edit</a>
                        <form method="post" asp-action="Delete" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="name" value="@service.Name" />
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
