@model Service
@{
    Layout = "_Layout";
    ViewData["Title"] = "Edit Service";
}

<div class="container-centered">
    <h1 class="mb-3">Edit Service</h1>

    @if (TempData["BookingSuccess"] is not null)
    {
        <div class="alert alert-success">@TempData["BookingSuccess"]</div>
    }

    @if (TempData["BookingError"] is not null)
    {
        <div class="alert alert-danger">@TempData["BookingError"]</div>
    }

    <form method="post" asp-action="Update" class="booking-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="originalName" value="@Model.Name" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <label>Name <input asp-for="Name" type="text" /></label>
        <span asp-validation-for="Name" class="text-danger"></span>
        <label>Description <textarea asp-for="Description" rows="2"></textarea></label>
        <span asp-validation-for="Description" class="text-danger"></span>
        <label>Duration (minutes) <input asp-for="BaseDuration" type="number" min="1" /></label>
        <span asp-validation-for="BaseDuration" class="text-danger"></span>
        <label>Base Price <input asp-for="BasePrice" type="number" step="0.01" min="0" /></label>
        <span asp-validation-for="BasePrice" class="text-danger"></span>
        <label>
            <input asp-for="IsActive" type="checkbox" />
            Active
        </label>

        <div class="d-flex gap-2">
            <button type="submit" class="btn-primary">Save</button>
            <a asp-action="Manage" class="btn btn-secondary">Back</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
