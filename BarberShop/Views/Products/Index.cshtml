@model List<Product>
@inject BarberShop.Services.Interfaces.IAdminAccessService adminAccessService

@{
    Layout = "_BarberLayout";
    ViewData["Title"] = "Products";
}

<section class="products-hero">
    <h1>Our Products</h1>
    <p>Premium barber products available for purchase</p>
</section>

@if (TempData["BookingSuccess"] is not null)
{
    <div class="alert alert-success">@TempData["BookingSuccess"]</div>
}
@if (TempData["BookingError"] is not null)
{
    <div class="alert alert-danger">@TempData["BookingError"]</div>
}

<div class="products-container">
    <div class="row">
        @foreach (var product in Model.Where(p => p.IsActive).OrderBy(p => p.Name))
        {
            <div class="col-md-6 col-lg-4">
                <div class="product-card">
                    <h3 class="product-name">@product.Name</h3>
                    <p class="product-description">@(string.IsNullOrWhiteSpace(product.Description) ? "Premium barber product." : product.Description)</p>
                    <div class="product-price">@product.Price.ToString("0.00") RON</div>
                    <form method="post" asp-controller="Cart" asp-action="Add" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@product.ProductId" />
                        <input type="hidden" name="name" value="@product.Name" />
                        <input type="hidden" name="price" value="@product.Price" />
                        <input type="hidden" name="quantity" value="1" />
                        <button type="submit" class="btn-add-cart">Add to Cart</button>
                    </form>
                    @if (adminAccessService.IsAdmin())
                    {
                        <a asp-controller="Products" asp-action="Edit" asp-route-name="@product.Name" class="btn btn-primary btn-sm mt-2">Edit</a>
                    }
                </div>
            </div>
        }
    </div>
</div>

@if (adminAccessService.IsAdmin())
{
    <div class="text-center mt-4">
        <a asp-controller="Products" asp-action="Manage" class="btn-primary">Manage Products</a>
    </div>
}
