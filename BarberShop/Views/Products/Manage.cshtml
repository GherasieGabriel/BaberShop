@model List<Product>
@{
    Layout = "_BarberLayout";
    ViewData["Title"] = "Manage Products";
}

<h1 class="mb-3">Manage Products</h1>

@if (TempData["BookingSuccess"] is not null)
{
    <div class="alert alert-success">@TempData["BookingSuccess"]</div>
}
@if (TempData["BookingError"] is not null)
{
    <div class="alert alert-danger">@TempData["BookingError"]</div>
}

<section class="mb-4">
    <h2>Add Product</h2>
    <form method="post" asp-action="Create" class="booking-form">
        @Html.AntiForgeryToken()
        <label>Name <input type="text" name="name" required /></label>
        <label>Description <textarea name="description" rows="2"></textarea></label>
        <label>Category <input type="text" name="category" required /></label>
        <label>Price <input type="number" name="price" min="0" step="0.01" required /></label>
        <label>Stock Quantity <input type="number" name="stockQuantity" min="0" required /></label>
        <label><input type="checkbox" name="isActive" value="true" checked /> Active</label>
        <button type="submit" class="btn-primary">Create</button>
    </form>
</section>

<section class="products-container">
    <h2>Products List</h2>
    <div class="row">
        @foreach (var product in Model.OrderBy(p => p.Name))
        {
            <div class="col-md-6 col-lg-4">
                <div class="product-card">
                    <h3 class="product-name">@product.Name</h3>
                    <p class="product-description">@(string.IsNullOrWhiteSpace(product.Description) ? "-" : product.Description)</p>
                    <div class="product-price">@product.Price.ToString("0.00") RON</div>
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@product.ProductId" class="btn-primary">Edit</a>
                        <form method="post" asp-action="Delete" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@product.ProductId" />
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
