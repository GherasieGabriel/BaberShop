@model Product
@{
    Layout = "_BarberLayout";
    ViewData["Title"] = "Edit Product";
}

<div class="container-centered">
    <h1 class="mb-3">Edit Product</h1>

    @if (TempData["BookingSuccess"] is not null)
    {
        <div class="alert alert-success">@TempData["BookingSuccess"]</div>
    }

    @if (TempData["BookingError"] is not null)
    {
        <div class="alert alert-danger">@TempData["BookingError"]</div>
    }

    <form method="post" asp-action="Update" class="booking-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="productId" value="@Model.ProductId" />
        <label>Name <input type="text" name="name" value="@Model.Name" required /></label>
        <label>Description <textarea name="description" rows="2">@Model.Description</textarea></label>
        <label>Category <input type="text" name="category" value="@Model.Category" required /></label>
        <label>Price <input type="number" name="price" min="0" step="0.01" value="@Model.Price" required /></label>
        <label>Stock Quantity <input type="number" name="stockQuantity" min="0" value="@Model.StockQuantity" required /></label>
        <label>
            @if (Model.IsActive)
            {
                <input type="checkbox" name="isActive" value="true" checked />
            }
            else
            {
                <input type="checkbox" name="isActive" value="true" />
            }
            Active
        </label>

        <div class="d-flex gap-2">
            <button type="submit" class="btn-primary">Save</button>
            <a asp-action="Manage" class="btn btn-secondary">Back</a>
        </div>
    </form>
</div>
